{
  "_comment": "Approved repository-settings state (M3-SEC-01, issue #25). scripts/check_repo_settings.py compares live GitHub settings against this file and fails on drift. Interim values approved via the waivers in docs/public-release-checklist.md §1.2 are part of the approved state; update this file only through a reviewed PR, and update it in the same change as any settings change (including the public-flip steps in §1.7).",
  "branch_protection_main": {
    "required_status_checks": {
      "strict": true,
      "checks": [
        "Dependency audit@15368",
        "Internal-reference gate@15368",
        "Lint and type check@15368",
        "Pre-commit baseline@15368",
        "Secret scan@15368",
        "Tests (Python 3.10)@15368",
        "Tests (Python 3.11)@15368",
        "Tests (Python 3.12)@15368",
        "Validate PR title@15368"
      ]
    },
    "required_pull_request_reviews": {
      "required_approving_review_count": 0,
      "require_code_owner_reviews": false,
      "dismiss_stale_reviews": false
    },
    "enforce_admins": false,
    "required_conversation_resolution": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "lock_branch": false
  },
  "actions_permissions": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true
  },
  "selected_actions": {
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": [
      "amannn/action-semantic-pull-request@*",
      "astral-sh/setup-uv@*",
      "pypa/gh-action-pypi-publish@*"
