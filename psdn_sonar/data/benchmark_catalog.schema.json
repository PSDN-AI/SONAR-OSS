{
  "$defs": {
    "BenchmarkSpec": {
      "additionalProperties": false,
      "description": "One cataloged benchmark integration.",
      "properties": {
        "allowed_configs": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Configs",
          "type": "array"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "availability": {
          "enum": [
            "active",
            "retired"
          ],
          "title": "Availability",
          "type": "string"
        },
        "config_template": {
          "title": "Config Template",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "expected_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Expected Fingerprints",
          "type": "object"
        },
        "expected_schema": {
          "$ref": "#/$defs/ExpectedSchema"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/LicenseSpec"
        },
        "preprocessing": {
          "$ref": "#/$defs/PreprocessingSpec"
        },
        "public_default": {
          "title": "Public Default",
          "type": "boolean"
        },
        "redistribution": {
          "$ref": "#/$defs/RedistributionSpec"
        },
        "rights_approval": {
          "$ref": "#/$defs/RightsApproval"
        },
        "runtime": {
          "enum": [
            "enabled",
            "disabled"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/SelectionSpec"
        },
        "source": {
          "$ref": "#/$defs/SourceSpec"
        },
        "splits": {
          "items": {
            "type": "string"
          },
          "title": "Splits",
          "type": "array"
        }
      },
      "required": [
        "id",
        "display_name",
        "availability",
        "runtime",
        "source",
        "config_template",
        "allowed_configs",
        "splits",
        "license",
        "redistribution",
        "attribution",
        "expected_schema",
        "selection",
        "preprocessing",
        "expected_fingerprints",
        "public_default",
        "rights_approval"
      ],
      "title": "BenchmarkSpec",
      "type": "object"
    },
    "ExpectedSchema": {
      "additionalProperties": false,
      "description": "Columns expected from the pinned upstream dataset.",
      "properties": {
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Columns",
          "type": "object"
        },
        "format": {
          "enum": [
            "huggingface",
            "tsv",
            "archive"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "format",
        "columns"
      ],
      "title": "ExpectedSchema",
      "type": "object"
    },
    "LicenseSpec": {
      "additionalProperties": false,
      "description": "License evidence, including an explicit unverified state.",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Identifier"
        },
        "status": {
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "status",
        "identifier",
        "url"
      ],
      "title": "LicenseSpec",
      "type": "object"
    },
    "PreprocessingSpec": {
      "additionalProperties": false,
      "description": "Versioned preprocessing identity.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PreprocessingSpec",
      "type": "object"
    },
    "RedistributionSpec": {
      "additionalProperties": false,
      "description": "Reviewed decision about copying dataset contents.",
      "properties": {
        "decision": {
          "enum": [
            "reference_only",
            "redistributable",
            "prohibited",
            "pending_human_approval"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale"
      ],
      "title": "RedistributionSpec",
      "type": "object"
    },
    "RightsApproval": {
      "additionalProperties": false,
      "description": "Named human approval; pending is intentionally not publishable.",
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved At"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved By"
        },
        "evidence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Url"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "evidence_url"
      ],
      "title": "RightsApproval",
      "type": "object"
    },
    "SelectionSpec": {
      "additionalProperties": false,
      "description": "Versioned rule that determines the ordered sample set.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "parameters"
      ],
      "title": "SelectionSpec",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "description": "Immutable public or private source coordinate.",
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "canonical_url": {
          "title": "Canonical Url",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "enum": [
            "huggingface",
            "openslr",
            "archive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identifier",
        "canonical_url",
        "revision",
        "visibility",
        "artifacts"
      ],
      "title": "SourceSpec",
      "type": "object"
    }
  },
  "$id": "https://github.com/PSDN-AI/SONAR-OSS/blob/main/psdn_sonar/data/benchmark_catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Validated catalog document.",
  "properties": {
    "benchmarks": {
      "additionalProperties": {
        "$ref": "#/$defs/BenchmarkSpec"
      },
      "minProperties": 1,
      "title": "Benchmarks",
      "type": "object"
    },
    "catalog_version": {
      "minimum": 1,
      "title": "Catalog Version",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "benchmarks"
  ],
  "title": "SONAR public benchmark catalog v1",
  "type": "object"
}
