# =============================================================================
# psdn-sonar environment variables
# Copy this file to .env and fill in the values you need.
# =============================================================================

# --- API Keys (required only for API-based ASR models) ---
# OPENAI_API_KEY=sk-...
# ELEVENLABS_API_KEY=...
# XI_API_KEY=...                        # Alternative for ElevenLabs
# ASSEMBLYAI_API_KEY=...

# --- HuggingFace (required for pyannote VAD/diarization) ---
# HF_TOKEN=hf_...

# --- POSEIDON Score Weights (defaults shown; must sum to 1.0) ---
# POSEIDON_WER_WEIGHT=0.35
# POSEIDON_CER_WEIGHT=0.20
# POSEIDON_SEMANTIC_WEIGHT=0.45

# --- Semantic Similarity Model ---
# SIMILARITY_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Audio Quality Thresholds (optional; defaults shown) ---
# SONAR_SNR_TIER_LOW=10.0
# SONAR_SNR_TIER_HIGH=20.0
# SONAR_SILENCE_THRESH_DB=-40.0
# SONAR_MAX_SILENCE_RATIO=0.60
# SONAR_MAX_CLIPPING_RATIO=0.001
# SONAR_CLIPPING_AMPLITUDE=0.99
# SONAR_MIN_SNR_DB=10.0
